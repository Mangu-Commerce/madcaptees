# ============================================================
# Madcap Tees — Environment Variables (Next.js)
# Copy this file to .env.local and fill in your actual values
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# From: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-only, never expose

# ── Stripe ───────────────────────────────────────────────────
# From: https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...                           # server-only
STRIPE_WEBHOOK_SECRET=whsec_...                         # server-only

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000              # Vercel URL in production

# ── Optional: Email / Fulfillment ────────────────────────────
RESEND_API_KEY=re_...
ADMIN_EMAIL=faith@madcaptees.com
